{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simpero.ai/contracts/facts.schema.json",
  "title": "Fact",
  "description": "The C3 seam contract: one fact row as emitted by the Python parse service across the JSON boundary to the TS app. The TS side validates against this SAME file. A change here must be made on both sides together, or the contract job fails.",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity", "attribute", "value", "confidence", "location"],
  "properties": {
    "id": { "type": "string" },
    "deal_id": { "type": "string" },
    "session_id": { "type": "string" },
    "org_id": { "type": "string" },

    "entity": {
      "type": "string",
      "description": "What the claim is about (company, segment, etc.)."
    },
    "attribute": {
      "type": "string",
      "description": "The field, e.g. revenueLatestUsd."
    },

    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "normalized", "unit", "value_type"],
      "description": "Unit-normalized at write time. raw is never overwritten.",
      "properties": {
        "raw": {
          "type": "string",
          "description": "Verbatim as printed, e.g. \"$15,295\"."
        },
        "normalized": {
          "type": ["number", "null"],
          "description": "After scale + unit applied, e.g. 15295000. null only when value_type is text."
        },
        "unit": {
          "type": ["string", "null"],
          "description": "e.g. USD, CAD, bp, ratio."
        },
        "scale_multiplier": {
          "type": ["number", "null"],
          "description": "What took raw -> normalized, e.g. 1000."
        },
        "scale_source": {
          "type": "string",
          "enum": ["explicit_in_value", "column_header", "page_header", "assumed_1x"],
          "description": "HOW scale was determined. assumed_1x must be distinguishable from a known 1x."
        },
        "value_type": {
          "type": "string",
          "enum": ["currency", "percent", "count", "ratio", "date", "text"],
          "description": "Drives tolerance selection downstream (GS-4 / Verify)."
        }
      }
    },

    "location": {
      "description": "Typed union by kind. PDF => page/char span; XLSX => sheet/cell_ref; DOCX => paragraph. Common document-level provenance on every kind.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "file", "page", "char_start", "char_end"],
          "properties": {
            "kind": { "const": "pdf" },
            "file": { "type": "string" },
            "document_id": { "type": "string" },
            "document_name": { "type": "string" },
            "document_version": { "type": ["integer", "string"] },
            "ingested_at": { "type": "string", "format": "date-time" },
            "document_date": { "type": ["string", "null"], "format": "date" },
            "page": { "type": "integer", "description": "PDF page index, not printed footer." },
            "paragraph": { "type": ["integer", "null"] },
            "char_start": { "type": "integer" },
            "char_end": { "type": "integer" },
            "bbox": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": { "type": "number" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "file", "sheet", "cell_ref"],
          "properties": {
            "kind": { "const": "xlsx" },
            "file": { "type": "string" },
            "document_id": { "type": "string" },
            "document_name": { "type": "string" },
            "document_version": { "type": ["integer", "string"] },
            "ingested_at": { "type": "string", "format": "date-time" },
            "document_date": { "type": ["string", "null"], "format": "date" },
            "sheet": { "type": "string" },
            "cell_ref": { "type": "string", "description": "e.g. B14" },
            "named_range": { "type": ["string", "null"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "file", "paragraph_index"],
          "properties": {
            "kind": { "const": "docx" },
            "file": { "type": "string" },
            "document_id": { "type": "string" },
            "document_name": { "type": "string" },
            "document_version": { "type": ["integer", "string"] },
            "ingested_at": { "type": "string", "format": "date-time" },
            "document_date": { "type": ["string", "null"], "format": "date" },
            "paragraph_index": { "type": "integer" },
            "table_id": { "type": ["string", "null"] },
            "row": { "type": ["integer", "null"] },
            "col": { "type": ["integer", "null"] }
          }
        }
      ]
    },

    "confidence": {
      "type": "string",
      "enum": ["extracted", "modeled", "formula-verified", "stub", "missing"],
      "description": "missing = not found; surfaces as provenance missing, never fabricated."
    },

    "section": { "type": ["string", "null"] },

    "flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ragged_table_rows",
          "chart_data_not_extracted",
          "scale_assumed",
          "quote_unresolved",
          "ambiguous_location",
          "ambiguous_region_bounds",
          "ambiguous_unit",
          "table_touches_page_edge",
          "zero_text_page",
          "empty_section"
        ]
      }
    }
  }
}
