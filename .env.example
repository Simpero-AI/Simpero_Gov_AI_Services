# Shared-secret checked against the X-Parser-Key header on POST /parse.
# Unset means "refuse to serve" (fail-closed, 503), not "auth disabled" — see
# parser_service/main.py's parse_auth dependency. Generate with e.g.
# `openssl rand -hex 32`; one distinct value per environment.
PARSER_API_KEY=CHANGEME

# Public hostname Caddy serves and provisions a Let's Encrypt cert for, e.g.
# services.simpero.com (production) or services-staging.simpero.com (staging).
PARSER_HOSTNAME=CHANGEME

# ---------------------------------------------------------------------------
# Optional: Docling document cache on DigitalOcean Spaces (S3-compatible).
# The cache stays DISABLED until bucket/endpoint/key/secret are all set (see
# document_cache.build_document_cache). The key + secret are a Spaces access
# key, distinct from a DO API token: DO console > API > Spaces Keys >
# Generate New Key (scope it to the bucket, read+write). The secret is shown
# once — paste it straight into .env, never into chat.
PARSER_SPACES_BUCKET=simpero-cim-xlsx-upload
PARSER_SPACES_REGION=tor1
PARSER_SPACES_ENDPOINT_URL=https://tor1.digitaloceanspaces.com
PARSER_SPACES_ACCESS_KEY_ID=CHANGEME
PARSER_SPACES_SECRET_ACCESS_KEY=CHANGEME

# Content-addressed cache keys are shared across tenants, so they must not
# also be shared across environments — an unreviewed staging parse could
# otherwise poison a cache entry production later reads as authoritative.
# MUST be set per-environment, e.g. parser/document-cache/staging or
# parser/document-cache/production.
PARSER_SPACES_KEY_PREFIX=CHANGEME

# ---------------------------------------------------------------------------
# NOT set here: IMAGE_TAG is supplied by the deploy workflow at deploy time
# (docker compose is invoked with IMAGE_TAG=<sha> in the environment), not
# read from this file.
